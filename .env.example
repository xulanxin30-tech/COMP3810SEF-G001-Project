PORT=3000
SESSION_SECRET=replace_with_a_long_random_string
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@cluster0.xxxxx.mongodb.net/<dbname>

# Facebook OAuth (Lecture 9). Leave empty to match the lecture slides'
# placeholder clientID/clientSecret; fill in only after you create an app at
# https://developers.facebook.com/ . The local callback URL is
# http://localhost:3000/auth/facebook/callback
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
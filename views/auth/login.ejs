<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Log In - G001 Library</title>
  <link rel="stylesheet" href="/css/auth.css">
</head>
<body>
  <main class="auth-card">
    <h1>Welcome back</h1>
    <p class="auth-subtitle">Student Library Book Management System</p>

    <% if (errors.length > 0) { %>
      <ul class="auth-errors">
        <% errors.forEach(function (err) { %>
          <li><%= err %></li>
        <% }) %>
      </ul>
    <% } %>

    <form method="POST" action="/auth/login" novalidate>
      <input type="hidden" name="next" value="<%= next %>">

      <label for="username">Username</label>
      <input id="username" name="username" type="text" value="<%= values.username || '' %>" autocomplete="username" required>

      <label for="password">Password</label>
      <input id="password" name="password" type="password" autocomplete="current-password" required>

      <button type="submit" class="auth-button">Log in</button>
    </form>

    <div class="auth-divider"><span>or</span></div>

    <% if (facebookConfigured) { %>
      <a class="auth-button auth-button-fb" href="/auth/facebook">Log in with Facebook</a>
    <% } else { %>
      <p class="auth-info">Facebook login (OAuth 2.0 / Passport, Lecture 9) is available. Set
        <code>FACEBOOK_APP_ID</code> and <code>FACEBOOK_APP_SECRET</code> in <code>.env</code> to enable it.</p>
    <% } %>

    <p class="auth-switch">No account yet? <a href="/auth/signup">Sign up</a></p>
  </main>
</body>
</html>

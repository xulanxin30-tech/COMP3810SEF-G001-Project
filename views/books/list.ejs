<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Book List - Library Management System</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>

    <%- include('../partials/navbar') %>

    <main class="container">
        <h1>Book List</h1>
        <p>View and manage library books.</p>

        <a href="/books/new" class="button">Add New Book</a>

        <table class="book-table">
            <thead>
                <tr>
                    <th>Title</th>
                    <th>Author</th>
                    <th>Category</th>
                    <th>Publisher</th>
                    <th>Year</th>
                    <th>Actions</th>
                </tr>
            </thead>

            <tbody>
                <% if (books.length > 0) { %>
                    <% books.forEach(function(book) { %>
                        <tr>
                            <td><%= book.title %></td>
                            <td><%= book.author %></td>
                            <td><%= book.category || '-' %></td>
                            <td><%= book.publisher || '-' %></td>
                            <td><%= book.publishYear || '-' %></td>
                            <td class="book-actions">
                                <a href="/books/<%= book._id %>/edit">
                                    Edit
                                </a>

                                <a href="/books/<%= book._id %>/delete">
                                    Delete
                                </a>
                            </td>
                        </tr>
                    <% }) %>
                <% } else { %>
                    <tr>
                        <td colspan="6">No books available.</td>
                    </tr>
                <% } %>
            </tbody>
        </table>
    </main>

    <%- include('../partials/footer') %>

</body>
</html>
